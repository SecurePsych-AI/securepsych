# .env.example — deployment-specific only
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# LangSmith — metadata tracing only.
# LANGCHAIN_HIDE_INPUTS and LANGCHAIN_HIDE_OUTPUTS are NOT here —
# they are enforced in code before any LangChain import.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-key
LANGCHAIN_PROJECT=securepsych-summarizer