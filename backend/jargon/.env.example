# .env.example — deployment-specific only
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# LangSmith — metadata tracing only. API key is a secret.
# LANGCHAIN_HIDE_INPUTS and LANGCHAIN_HIDE_OUTPUTS are NOT here —
# they are enforced in code and are not configurable.
# WARNING: DO NOT set to true on school hardware. When enabled, LangSmith sends
# run metadata (timing, token counts, model names) to api.smith.langchain.com —
# any external call violates the FERPA air-gap requirement. Use only on a
# developer laptop that is disconnected from the school LAN.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-key
LANGCHAIN_PROJECT=securepsych-jargon
