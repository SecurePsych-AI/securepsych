JWT_SECRET=your-256-bit-hex-secret-here
GATEWAY_USERNAME=your-login-username
GATEWAY_PASSWORD=your-strong-password

# Path to the SQLite database file — MUST be on the LUKS-encrypted mount.
# Example: /mnt/securepsych/data/gateway/gateway.db
GATEWAY_DB_PATH=/mnt/securepsych/data/gateway/gateway.db

# Secret key for keyed BLAKE2b hashing of raw student identifiers.
# WARNING: treat like the LUKS master key. Rotating this value orphans all
# existing student_id_hash records in the database — never rotate without a
# migration script that rehashes every Project row.
STUDENT_HASH_SECRET=your-64-char-hex-secret-here

# Runtime environment. Use "production" on the server; tests always override
# this to "test" in conftest.py to bypass the LUKS path check.
SECUREPSYCH_ENV=production-or-test
